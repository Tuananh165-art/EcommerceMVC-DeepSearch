@model IEnumerable<ECommerceMVC.ViewModels.MenuLoaiVM>

<div class="catagories-menu">
    <ul>
        <li class="@(Context.Request.Query.ContainsKey("loai") ? "" : "active")">
            <a asp-controller="HangHoa" asp-action="Index">Tất cả</a>
        </li>
        @foreach (var item in Model)
        {
            <li class="@(Context.Request.Query["loai"] == item.MaLoai.ToString() ? "active" : "")">
                <a asp-controller="HangHoa" asp-action="Index" asp-route-loai="@item.MaLoai">@item.TenLoai (@item.SoLuong)</a>
            </li>
        }
    </ul>
</div>
