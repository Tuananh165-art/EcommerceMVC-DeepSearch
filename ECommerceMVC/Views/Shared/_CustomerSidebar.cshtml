@using ECommerceMVC.Data
@using ECommerceMVC.Helpers
@inject Hshop2023Context Db
@{
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();

    var isHome = controller == "home";
    var isShop = controller == "hanghoa";
    var isCart = controller == "cart" && action == "index";
    var isCheckout = controller == "cart" && action == "checkout";

    var customerId = Context.Session.Get<string>(MySetting.CUSTOMER_KEY);
    var isAdmin = !string.IsNullOrWhiteSpace(customerId)
        && Db.KhachHangs.Any(x => x.MaKh == customerId && x.HieuLuc && x.VaiTro == MySetting.ADMIN_ROLE);
}

<header class="header-area clearfix">
    <div class="nav-close">
        <i class="fa fa-close" aria-hidden="true"></i>
    </div>
    <div class="logo">
        <a asp-controller="Home" asp-action="Index"><img src="~/amado/img/core-img/logo.png" alt="" /></a>
    </div>
    <nav class="amado-nav">
        <ul>
            <li class="@(isHome ? "active" : string.Empty)"><a asp-controller="Home" asp-action="Index">Home</a></li>
            @if (isAdmin)
            {
                <li class="@(controller == "hanghoas" && action == "create" ? "active" : string.Empty)"><a asp-controller="HangHoas" asp-action="Create">Create product</a></li>
            }
            <li class="@(isShop ? "active" : string.Empty)"><a asp-controller="HangHoa" asp-action="Index">Shop</a></li>
            <li class="@(isCart ? "active" : string.Empty)"><a asp-controller="Cart" asp-action="Index">Cart</a></li>
            <li class="@(isCheckout ? "active" : string.Empty)"><a asp-controller="Cart" asp-action="Checkout">Checkout</a></li>
        </ul>
    </nav>
    <div class="amado-btn-group mt-30 mb-100">
        <a asp-controller="HangHoa" asp-action="Discount" class="btn amado-btn mb-15">%Discount%</a>
        <a asp-controller="HangHoa" asp-action="NewThisWeek" class="btn amado-btn active">New this week</a>
    </div>
    <div class="cart-fav-search mb-100">
        @await Component.InvokeAsync("Cart")
        <a asp-controller="HangHoa" asp-action="Favourite" class="fav-nav"><img src="~/amado/img/core-img/favorites.png" alt="" /> Favourite</a>
        <a href="#" class="search-nav"><img src="~/amado/img/core-img/search.png" alt="" /> Search</a>
    </div>
    <div class="social-info d-flex justify-content-between">
        <a href="#"><i class="fa fa-pinterest" aria-hidden="true"></i></a>
        <a href="#"><i class="fa fa-instagram" aria-hidden="true"></i></a>
        <a href="#"><i class="fa fa-facebook" aria-hidden="true"></i></a>
        <a href="#"><i class="fa fa-twitter" aria-hidden="true"></i></a>
    </div>
</header>
