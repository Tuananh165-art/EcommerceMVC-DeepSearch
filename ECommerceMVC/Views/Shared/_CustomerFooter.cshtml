<footer class="modern-footer">
    <div class="footer-grid">
        <!-- Column 1: Brand & About -->
        <div class="footer-col">
            <a asp-controller="Home" asp-action="Index" class="navbar-logo mb-4 d-inline-block" style="font-size: var(--text-2xl); font-weight: 800;">
                DEEPSEARCH
            </a>
            <p style="margin-bottom: var(--space-4);">DEEPSEARCH mang đến catalog lifestyle mở rộng với home goods, travel gear, tech essentials và decor hiện đại trong trải nghiệm mua sắm rõ ràng, tinh tế và thực tế hơn.</p>
            <p class="d-flex align-items-center gap-2 mb-2" style="font-size: var(--text-sm);">
                <i data-icon="phone" data-size="16px"></i> +84 123 456 789
            </p>
            <p class="d-flex align-items-center gap-2" style="font-size: var(--text-sm);">
                <i data-icon="mail" data-size="16px"></i> DeepSearchSupport@gmail.com
            </p>
        </div>

        <!-- Column 2: Quick Links -->
        <div class="footer-col">
            <h4>Khám Phá</h4>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
                <a asp-controller="HangHoa" asp-action="Index">Cửa Hàng</a>
                <a asp-controller="HangHoa" asp-action="Discount">% Khuyến Mãi %</a>
                <a asp-controller="HangHoa" asp-action="NewThisWeek">Hàng Mới Tuần Này</a>
            </div>
        </div>

        <!-- Column 3: Customer Care -->
        <div class="footer-col">
            <h4>Chăm Sóc Khách Hàng</h4>
            <div class="footer-links">
                <a asp-controller="Cart" asp-action="Index">Giỏ Hàng Của Bạn</a>
                <a asp-controller="Cart" asp-action="Checkout">Thanh Toán</a>
                <a asp-controller="KhachHang" asp-action="EditProfile">Tài Khoản Cá Nhân</a>
                <a href="#">Chính Sách Đổi Trả</a>
            </div>
        </div>

        <!-- Column 4: Social Connection -->
        <div class="footer-col">
            <h4>Kết Nối Với Chúng Tôi</h4>
            <p style="margin-bottom: var(--space-4);">Theo dõi các kênh mạng xã hội của DEEPSEARCH để cập nhật các xu hướng thiết kế mới.</p>
            <div class="footer-social">
                <a href="#" aria-label="Facebook"><i data-icon="facebook"></i></a>
                <a href="#" aria-label="Instagram"><i data-icon="instagram"></i></a>
                <a href="#" aria-label="Twitter"><i data-icon="twitter"></i></a>
                <a href="#" aria-label="Pinterest"><i data-icon="pinterest"></i></a>
            </div>
        </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
        <div>
            &copy; @DateTime.Now.Year DEEPSEARCH. Tất cả các quyền được bảo lưu. Thiết kế cho mục đích học tập & thực hành.
        </div>
        <div class="d-flex gap-4">
            <a href="#" style="color: inherit; text-decoration: none;">Điều khoản dịch vụ</a>
            <a href="#" style="color: inherit; text-decoration: none;">Bảo mật thông tin</a>
        </div>
    </div>

    <!-- Back to Top Button -->
    <button class="back-to-top" aria-label="Trở lại đầu trang">
        <i data-icon="chevron-up" data-size="20px"></i>
    </button>
</footer>

