@using ECommerceMVC.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@(ViewData["Title"] ?? "ECommerce MVC")</title>

    <link rel="icon" href="~/amado/img/core-img/favicon.ico" />

    <link rel="stylesheet" href="~/amado/css/core-style.css" />
    <link rel="stylesheet" href="~/amado/style.css" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="search-wrapper section-padding-100">
        <div class="search-close">
            <i class="fa fa-close" aria-hidden="true"></i>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="search-content">
                        <form asp-controller="HangHoa" asp-action="Search" method="get">
                            <input type="search" name="query" id="search" placeholder="Tìm sản phẩm..." />
                            <button type="submit"><img src="~/amado/img/core-img/search.png" alt="search" /></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="main-content-wrapper d-flex clearfix">
        <div class="mobile-nav">
            <div class="amado-navbar-brand">
                <a asp-controller="HangHoa" asp-action="Index"><img src="~/amado/img/core-img/logo.png" alt="logo" /></a>
            </div>
            <div class="amado-navbar-toggler">
                <span></span><span></span><span></span>
            </div>
        </div>

        <header class="header-area clearfix">
            <div class="nav-close">
                <i class="fa fa-close" aria-hidden="true"></i>
            </div>
            <div class="logo">
                <a asp-controller="HangHoa" asp-action="Index"><img src="~/amado/img/core-img/logo.png" alt="logo" /></a>
            </div>
            <nav class="amado-nav">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-controller="HangHoa" asp-action="Index">Cửa hàng</a></li>
                    <li><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
                    <li><a asp-controller="Cart" asp-action="Checkout">Thanh toán COD</a></li>
                    <li><a asp-controller="Cart" asp-action="LichSuDonHang">Đơn COD</a></li>

                    @if (Context.Session.Get<string>(MySetting.CUSTOMER_KEY) == null)
                    {
                        <li><a asp-controller="KhachHang" asp-action="DangNhap">Đăng nhập</a></li>
                        <li><a asp-controller="KhachHang" asp-action="DangKy">Đăng ký</a></li>
                    }
                    else
                    {
                        <li>
                            <form asp-controller="KhachHang" asp-action="DangXuat" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn p-0" style="background:none;border:none;color:inherit;cursor:pointer;line-height:1.6;">Đăng xuất</button>
                            </form>
                        </li>
                    }
                </ul>
            </nav>

            <div class="amado-btn-group mt-30 mb-100">
                <a href="#" class="btn amado-btn mb-15">%Discount%</a>
                <a href="#" class="btn amado-btn active">New this week</a>
            </div>

            <div class="cart-fav-search mb-100">
                @await Component.InvokeAsync("Cart")
                <a href="#" class="search-nav"><img src="~/amado/img/core-img/search.png" alt="search" /> Tìm kiếm</a>
            </div>

            <div class="social-info d-flex justify-content-between">
                <a href="#"><i class="fa fa-pinterest" aria-hidden="true"></i></a>
                <a href="#"><i class="fa fa-instagram" aria-hidden="true"></i></a>
                <a href="#"><i class="fa fa-facebook" aria-hidden="true"></i></a>
                <a href="#"><i class="fa fa-twitter" aria-hidden="true"></i></a>
            </div>
        </header>

        <div style="width: 100%;">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="container-fluid pt-3">
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="container-fluid pt-3">
                    <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="~/amado/js/jquery/jquery-2.2.4.min.js"></script>
    <script src="~/amado/js/popper.min.js"></script>
    <script src="~/amado/js/bootstrap.min.js"></script>
    <script src="~/amado/js/plugins.js"></script>
    <script src="~/amado/js/active.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
