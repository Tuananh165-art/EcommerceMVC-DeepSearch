<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_CustomerHead" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <partial name="_CustomerSearchOverlay" />
    <partial name="_CustomerFlashMessage" />

    <!-- Modern Top Navigation Bar -->
    <partial name="_ModernNavbar" />

    <!-- Main Page Content -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Shared Sections -->
    <partial name="_CustomerNewsletter" model="new ECommerceMVC.ViewModels.NewsletterSubscribeVM()" />
    <partial name="_CustomerFooter" />

    <!-- Core Scripting -->
    <partial name="_CustomerScripts" />
    @RenderSection("Scripts", required: false)
</body>
</html>

