@model IEnumerable<ECommerceMVC.ViewModels.HangHoaVM>

@foreach (var item in Model)
{
    <div class="col-12 col-sm-6 col-md-12 col-xl-6">
        <div class="single-product-wrapper">
            <div class="product-img">
                <img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHH" style="height: 320px; object-fit: cover; width: 100%;" />
            </div>

            <div class="product-description d-flex align-items-center justify-content-between">
                <div class="product-meta-data">
                    <div class="line"></div>
                    <p class="product-price">$@item.DonGia</p>
                    <a asp-action="Detail" asp-controller="HangHoa" asp-route-id="@item.MaHh">
                        <h6>@item.TenHH</h6>
                    </a>
                    <small>@item.TenLoai</small>
                </div>
                <div class="ratings-cart text-right">
                    <div class="cart">
                        <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.MaHh" title="Add to Cart">
                            <img src="~/amado/img/core-img/cart.png" alt="cart" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
