@model ECommerceMVC.ViewModels.ChiTietHangHoaVM
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="single-product-area section-padding-100 clearfix">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mt-50">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="breadcrumb-item"><a asp-controller="HangHoa" asp-action="Index">Shop</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.TenHH</li>
                    </ol>
                </nav>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-lg-7">
                <div class="single_product_thumb">
                    <img class="d-block w-100" src="~/Hinh/HangHoa/@Model.Hinh" alt="@Model.TenHH" style="max-height: 520px; object-fit: cover;" />
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="single_product_desc">
                    <div class="product-meta-data">
                        <div class="line"></div>
                        <p class="product-price">$@Model.DonGia</p>
                        <h6>@Model.TenHH</h6>
                        <p class="avaibility"><i class="fa fa-circle"></i> In Stock (@Model.SoLuongTon)</p>
                    </div>

                    <div class="short_overview my-5">
                        <p>@Model.MoTaNgan</p>
                        <p>@Model.ChiTiet</p>
                    </div>

                    <form class="cart clearfix" asp-action="AddToCart" asp-controller="Cart" asp-route-id="@Model.MaHh" method="post">
                        <div class="cart-btn d-flex mb-50">
                            <p>Qty</p>
                            <div class="quantity">
                                <span class="qty-minus" onclick="var effect=document.getElementById('qty'); var qty=effect.value; if(!isNaN(qty) && qty > 1) effect.value--; return false;"><i class="fa fa-caret-down" aria-hidden="true"></i></span>
                                <input type="number" class="qty-text" id="qty" step="1" min="1" max="300" name="quantity" value="1" />
                                <span class="qty-plus" onclick="var effect=document.getElementById('qty'); var qty=effect.value; if(!isNaN(qty)) effect.value++; return false;"><i class="fa fa-caret-up" aria-hidden="true"></i></span>
                            </div>
                        </div>
                        <button type="submit" class="btn amado-btn">Add to cart</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
