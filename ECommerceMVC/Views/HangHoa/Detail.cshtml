@section Scripts {
    <script>
        (() => {
            const qtyInput = document.getElementById('qty');
            if (!qtyInput) {
                return;
            }

            const normalize = () => {
                const min = Number(qtyInput.min || 1);
                const max = Number(qtyInput.max || qtyInput.value || 1);
                let value = Number(qtyInput.value || min);

                if (Number.isNaN(value) || value < min) {
                    value = min;
                }

                if (value > max) {
                    value = max;
                }

                qtyInput.value = value;
            };

            qtyInput.addEventListener('change', normalize);
            normalize();
        })();
    </script>
}






