@model IEnumerable<ECommerceMVC.ViewModels.HangHoaVM>
@{
    ViewData["Title"] = "DEEPSEARCH | Luxury Furniture & Curated Living";
}

<section class="lux-hero">
    <div class="lux-hero-backdrop"></div>
    <div class="lux-hero-sheen"></div>

    <div class="container-modern">
        <div class="lux-hero-grid">
            <div class="lux-copy reveal">
                <span class="lux-kicker">DEEPSEARCH · CURATED LIVING</span>

                <h1 class="lux-title">
                    Không gian sống tinh giản,
                    <span>sang trọng và dễ ứng dụng</span>
                </h1>

                <p class="lux-subtitle">
                    DEEPSEARCH tuyển chọn nội thất, décor và lifestyle essentials theo bảng màu ấm,
                    chất liệu giàu chiều sâu và tỷ lệ hài hòa để mỗi góc nhà đều trở nên thư thái,
                    hiện đại và cao cấp.
                </p>

                <div class="lux-cta-row">
                    <a asp-controller="HangHoa" asp-action="Index" class="btn-modern lux-btn-primary rounded-pill">
                        Khám phá bộ sưu tập
                    </a>
                    <a asp-controller="Showroom" asp-action="Index" class="btn-modern lux-btn-secondary rounded-pill">
                        Trải nghiệm showroom 3D
                    </a>
                </div>

                <div class="lux-proof-grid">
                    <article class="lux-proof-card reveal stagger-item">
                        <span class="lux-proof-label">Tuyển chọn</span>
                        <strong class="lux-proof-value">36+ thiết kế</strong>
                        <p class="lux-proof-copy">Bộ sưu tập được chọn lại theo tinh thần luxury hiện đại, tông ấm và dễ phối.</p>
                    </article>

                    <article class="lux-proof-card reveal stagger-item">
                        <span class="lux-proof-label">Chất liệu & bảng màu</span>
                        <strong class="lux-proof-value">Natural Luxe Palette</strong>
                        <p class="lux-proof-copy">Palette đồng nhất với điểm nhấn champagne bronze để tạo chiều sâu sang trọng.</p>
                    </article>

                    <article class="lux-proof-card reveal stagger-item">
                        <span class="lux-proof-label">Trải nghiệm</span>
                        <strong class="lux-proof-value">Dễ xem, dễ chọn, dễ phối</strong>
                        <p class="lux-proof-copy">Bố cục sạch, CTA rõ ràng và gợi ý hình ảnh phù hợp cho không gian sống cao cấp.</p>
                    </article>
                </div>
            </div>

            <div class="lux-visual-cluster reveal">
                <article class="lux-visual-card lux-visual-card-primary">
                    <img src="/Hinh/HangHoa/web-floor-lamp-01.jpg" alt="Không gian phòng khách tông gỗ ấm và ánh sáng dịu" />
                    <div class="lux-visual-overlay"></div>
                    <div class="lux-visual-content">
                        <span class="lux-visual-kicker">Phòng khách tông ấm</span>
                        <h3>Đường nét gỗ walnut, ánh sáng dịu và décor tinh giản cho không gian sống hiện đại.</h3>
                        <a asp-controller="HangHoa" asp-action="Index" asp-route-q="walnut" class="lux-inline-link">
                            Khám phá thiết kế gỗ ấm
                            <i data-icon="arrow-right" data-size="14px"></i>
                        </a>
                    </div>
                </article>

                <article class="lux-visual-card lux-visual-card-secondary">
                    <img src="/Hinh/HangHoa/lux-gold-dining-room.jpg" alt="Không gian dining luxury với ánh sáng ấm" />
                    <div class="lux-visual-overlay"></div>
                    <div class="lux-visual-content">
                        <span class="lux-visual-kicker">Dining edit</span>
                        <h3>Ánh sáng, gỗ sáng màu và décor tinh tế tạo nên trải nghiệm dining giàu chiều sâu.</h3>
                        <a asp-controller="HangHoa" asp-action="Index" asp-route-q="dining" class="lux-inline-link">
                            Xem bộ dining
                            <i data-icon="arrow-right" data-size="14px"></i>
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="section-padding pt-0 home-featured-section">
    <div class="container-modern home-featured-shell">
        <div class="home-featured-header reveal">
            <div class="home-featured-copy">
                <span class="lux-kicker">FEATURED PRODUCTS</span>
                <h2 class="lux-section-title">Sản phẩm nổi bật cho không gian sống cao cấp</h2>
                <p class="home-featured-subtitle">
                    Tuyển chọn những thiết kế có bảng màu ấm, hoàn thiện sang trọng và tỷ lệ hài hòa để không gian sống vừa tinh tế vừa dễ ứng dụng trong căn hộ, nhà phố và studio hiện đại.
                </p>
            </div>

            <div class="home-featured-action">
                <a asp-controller="HangHoa" asp-action="Index" class="btn-modern home-featured-btn rounded-pill">
                    Xem tất cả
                    <i data-icon="arrow-right" data-size="14px"></i>
                </a>
            </div>
        </div>

        <div class="row home-featured-grid">
            @if (Model.Any())
            {
                <partial name="~/Views/HangHoa/ProductItem.cshtml" model="Model.Take(6)" />
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="mb-3" style="color: var(--text-tertiary);">
                        <i data-icon="alert-circle" data-size="48px"></i>
                    </div>
                    <p class="text-secondary">Không tìm thấy sản phẩm nổi bật nào.</p>
                </div>
            }
        </div>
    </div>
</section>

