@model IEnumerable<ECommerceMVC.Data.HangHoa>
@using ECommerceMVC.Helpers

@{
    ViewData["Title"] = "Quản lý hàng hóa";
}

@section Styles {
    <style>
        .admin-products-table-wrap {
            overflow-x: auto;
            background: #fff;
            padding: 12px;
            border-radius: 6px;
        }

        .admin-products-table {
            min-width: 1200px;
            margin-bottom: 0;
            background: #fff;
        }

        .admin-products-table thead th {
            white-space: nowrap;
            vertical-align: middle;
            font-weight: 600;
        }

        .admin-products-table tbody td {
            vertical-align: middle;
        }

        .admin-products-actions {
            white-space: nowrap;
        }
    </style>
}

<div class="cart-table-area section-padding-100">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-11">
                <div class="cart-title mt-50">
                    <h2>Quản lý hàng hóa</h2>
                </div>

                @if (TempData["SyncError"] != null)
                {
                    <div class="alert alert-warning">@TempData["SyncError"]</div>
                }
                @if (TempData["SyncSuccess"] != null)
                {
                    <div class="alert alert-success">@TempData["SyncSuccess"]</div>
                }

                <div class="mb-3 d-flex flex-wrap" style="gap:8px;">
                    <a asp-action="Create" class="btn amado-btn">Thêm mới</a>
                    <form asp-action="SyncImagesByAlias" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning">Sync ảnh từ /Hinh/HangHoa theo TenAlias</button>
                    </form>
                </div>

                <div class="admin-products-table-wrap">
                    <table class="table admin-products-table">
                        <thead>
                            <tr>
                                <th>Ảnh</th>
                                <th>@Html.DisplayNameFor(model => model.TenHh)</th>
                                <th>@Html.DisplayNameFor(model => model.TenAlias)</th>
                                <th>@Html.DisplayNameFor(model => model.MoTaDonVi)</th>
                                <th>@Html.DisplayNameFor(model => model.DonGia)</th>
                                <th>@Html.DisplayNameFor(model => model.Hinh)</th>
                                <th>@Html.DisplayNameFor(model => model.NgaySx)</th>
                                <th>@Html.DisplayNameFor(model => model.GiamGia)</th>
                                <th>@Html.DisplayNameFor(model => model.SoLuongTon)</th>
                                <th>@Html.DisplayNameFor(model => model.SoLanXem)</th>
                                <th>@Html.DisplayNameFor(model => model.MoTa)</th>
                                <th>@Html.DisplayNameFor(model => model.MaLoaiNavigation)</th>
                                <th>@Html.DisplayNameFor(model => model.MaNccNavigation)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center" style="width: 90px;">
                                        <img src="@MyUtil.GetHangHoaImageUrl(item.Hinh, item.MaHh)" alt="@item.TenHh" style="width:64px;height:64px;object-fit:cover;border-radius:6px;" />
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.TenHh)</td>
                                    <td>@Html.DisplayFor(modelItem => item.TenAlias)</td>
                                    <td>@Html.DisplayFor(modelItem => item.MoTaDonVi)</td>
                                    <td>@Html.DisplayFor(modelItem => item.DonGia)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Hinh)</td>
                                    <td>@Html.DisplayFor(modelItem => item.NgaySx)</td>
                                    <td>@Html.DisplayFor(modelItem => item.GiamGia)</td>
                                    <td>@Html.DisplayFor(modelItem => item.SoLuongTon)</td>
                                    <td>@Html.DisplayFor(modelItem => item.SoLanXem)</td>
                                    <td>@Html.DisplayFor(modelItem => item.MoTa)</td>
                                    <td>@Html.DisplayFor(modelItem => item.MaLoaiNavigation.MaLoai)</td>
                                    <td>@Html.DisplayFor(modelItem => item.MaNccNavigation.MaNcc)</td>
                                    <td class="admin-products-actions">
                                        <a asp-action="Edit" asp-route-id="@item.MaHh">Edit</a> |
                                        <a asp-action="Details" asp-route-id="@item.MaHh">Details</a> |
                                        <a asp-action="Delete" asp-route-id="@item.MaHh">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
