@model ECommerceMVC.ViewModels.VerifyOtpResetPasswordVM
@{
    ViewData["Title"] = "Đặt lại mật khẩu | DEEPSEARCH";
}

<div class="auth-page-shell">
    <div class="container-modern auth-page-container">
        <div class="auth-login-card reveal">
            <div class="auth-login-visual">
                <div class="auth-visual-glow auth-visual-glow-top"></div>
                <div class="auth-visual-glow auth-visual-glow-bottom"></div>
                <div class="auth-visual-copy">
                    <span class="auth-visual-kicker">OTP VERIFY</span>
                    <h2>Xác nhận OTP và tạo mật khẩu mới</h2>
                    <p>Nhập mã OTP 6 chữ số đã gửi qua email. Không chia sẻ mã này với bất kỳ ai.</p>
                </div>
                <div class="auth-visual-note">
                    <strong>Mã có hiệu lực 10 phút</strong>
                    <span>Nếu mã hết hạn, hãy quay lại màn quên mật khẩu để gửi mã mới.</span>
                </div>
            </div>

            <div class="auth-login-form-panel">
                <div class="auth-form-header">
                    <span class="auth-form-kicker">Đặt lại mật khẩu</span>
                    <h1>Nhập OTP và mật khẩu mới</h1>
                    <p>Tài khoản: <strong>@Model.MaKh</strong></p>
                </div>

                <form asp-action="ResetPasswordWithOtp" method="post" class="auth-form-stack">
                    @Html.AntiForgeryToken()
                    <input asp-for="MaKh" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 text-sm p-3 mb-0 auth-validation"></div>

                    <div class="auth-field-group">
                        <label asp-for="Otp" class="auth-label"></label>
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon"><i data-icon="shield" data-size="16px"></i></span>
                            <input asp-for="Otp" class="auth-input" inputmode="numeric" maxlength="6" placeholder="123456" required />
                        </div>
                        <span asp-validation-for="Otp" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <div class="auth-field-group">
                        <label asp-for="NewPassword" class="auth-label"></label>
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon"><i data-icon="lock" data-size="16px"></i></span>
                            <input asp-for="NewPassword" class="auth-input" placeholder="Mật khẩu mới" required />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <div class="auth-field-group">
                        <label asp-for="ConfirmPassword" class="auth-label"></label>
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon"><i data-icon="check-circle" data-size="16px"></i></span>
                            <input asp-for="ConfirmPassword" class="auth-input" placeholder="Nhập lại mật khẩu mới" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn-modern btn-primary-modern w-100 py-3 rounded-pill shadow-glow" data-click-notify="Đang đặt lại mật khẩu...">
                        Đặt lại mật khẩu
                    </button>
                </form>

                <div class="auth-form-footer">
                    <span>Chưa nhận được mã?</span>
                    <a asp-action="ForgotPassword" asp-controller="KhachHang">Gửi lại OTP</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
