@model ECommerceMVC.ViewModels.ForgotPasswordVM
@{
    ViewData["Title"] = "Quên mật khẩu | DEEPSEARCH";
}

<div class="auth-page-shell">
    <div class="container-modern auth-page-container">
        <div class="auth-login-card reveal">
            <div class="auth-login-visual">
                <div class="auth-visual-glow auth-visual-glow-top"></div>
                <div class="auth-visual-glow auth-visual-glow-bottom"></div>
                <div class="auth-visual-copy">
                    <span class="auth-visual-kicker">PASSWORD RESET</span>
                    <h2>Lấy lại quyền truy cập tài khoản</h2>
                    <p>Nhập email hoặc tên đăng nhập. Hệ thống sẽ gửi mã OTP 6 chữ số tới email đã đăng ký nếu tài khoản tồn tại.</p>
                </div>
                <div class="auth-visual-note">
                    <strong>Bảo mật OTP</strong>
                    <span>Mã OTP chỉ có hiệu lực trong 10 phút và sẽ bị khóa sau nhiều lần nhập sai.</span>
                </div>
            </div>

            <div class="auth-login-form-panel">
                <div class="auth-form-header">
                    <span class="auth-form-kicker">Quên mật khẩu</span>
                    <h1>Gửi mã OTP đặt lại mật khẩu</h1>
                    <p>Vui lòng kiểm tra email sau khi gửi yêu cầu.</p>
                </div>

                <form asp-action="ForgotPassword" method="post" class="auth-form-stack">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 text-sm p-3 mb-0 auth-validation"></div>

                    <div class="auth-field-group">
                        <label asp-for="EmailOrUsername" class="auth-label"></label>
                        <div class="auth-input-wrap">
                            <span class="auth-input-icon"><i data-icon="mail" data-size="16px"></i></span>
                            <input asp-for="EmailOrUsername" class="auth-input" placeholder="Email hoặc tên đăng nhập" required />
                        </div>
                        <span asp-validation-for="EmailOrUsername" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn-modern btn-primary-modern w-100 py-3 rounded-pill shadow-glow" data-click-notify="Đang gửi mã OTP...">
                        Gửi mã OTP
                    </button>
                </form>

                <div class="auth-form-footer">
                    <span>Đã nhớ mật khẩu?</span>
                    <a asp-action="DangNhap" asp-controller="KhachHang">Quay lại đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
