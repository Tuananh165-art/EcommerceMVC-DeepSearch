@model ECommerceMVC.ViewModels.ForgotPasswordVM
@{
    ViewData["Title"] = "Khoi phuc tai khoan | DEEPSEARCH";
}

<section class="fp-shell">
    <div class="fp-split">
        <aside class="fp-brand" aria-hidden="true">
            <div class="fp-brand-overlay"></div>
            <div class="fp-brand-content">
                <p class="fp-kicker">DEEPSEARCH</p>
                <h2>Luxury Account Recovery</h2>
                <p>Khong gian mua sam tinh te, bao mat va lien mach trong tung buoc xac thuc.</p>
            </div>
        </aside>

        <div class="fp-form-wrap">
            <div class="fp-card">
                <div class="fp-steps" aria-label="Reset steps">
                    <span class="is-active" data-step-dot="1">1</span>
                    <span data-step-dot="2">2</span>
                    <span data-step-dot="3">3</span>
                    <span data-step-dot="4">4</span>
                </div>

                <form id="recoveryForm" class="fp-form" novalidate>
                    @Html.AntiForgeryToken()

                    <section class="fp-step is-active" data-step="1">
                        <h1>Khoi phuc tai khoan</h1>
                        <p>Nhap email hoac ten dang nhap de nhan ma OTP xac thuc.</p>
                        <label for="emailOrUsername">Email hoac ten dang nhap</label>
                        <input id="emailOrUsername" name="emailOrUsername" type="text" autocomplete="username" required />
                        <small class="fp-error" data-error="identifier"></small>
                        <button type="button" class="fp-btn fp-btn-primary" id="btnSendOtp">Gui ma OTP</button>
                    </section>

                    <section class="fp-step" data-step="2">
                        <h1>Xac thuc OTP</h1>
                        <p>Ma OTP da duoc gui toi <strong id="maskedEmail"></strong></p>
                        <div class="fp-otp" role="group" aria-label="Nhap OTP 6 so">
                            <input inputmode="numeric" maxlength="1" class="otp-digit" />
                            <input inputmode="numeric" maxlength="1" class="otp-digit" />
                            <input inputmode="numeric" maxlength="1" class="otp-digit" />
                            <input inputmode="numeric" maxlength="1" class="otp-digit" />
                            <input inputmode="numeric" maxlength="1" class="otp-digit" />
                            <input inputmode="numeric" maxlength="1" class="otp-digit" />
                        </div>
                        <small class="fp-error" data-error="otp"></small>
                        <div class="fp-inline-actions">
                            <button type="button" class="fp-btn fp-btn-primary" id="btnVerifyOtp">Xac thuc OTP</button>
                            <button type="button" class="fp-btn fp-btn-secondary" id="btnResendOtp">Gui lai (<span id="countdown">60</span>s)</button>
                            <button type="button" class="fp-link" id="btnChangeIdentifier">Doi email</button>
                        </div>
                    </section>

                    <section class="fp-step" data-step="3">
                        <h1>Tao mat khau moi</h1>
                        <p>Mat khau can toi thieu 8 ky tu, gom chu hoa, chu thuong, so, ky tu dac biet.</p>
                        <label for="newPassword">Mat khau moi</label>
                        <input id="newPassword" type="password" autocomplete="new-password" />
                        <label for="confirmPassword">Xac nhan mat khau moi</label>
                        <input id="confirmPassword" type="password" autocomplete="new-password" />
                        <div class="fp-strength"><span id="strengthBar"></span></div>
                        <small class="fp-error" data-error="password"></small>
                        <button type="button" class="fp-btn fp-btn-primary" id="btnCompleteReset">Dat lai mat khau</button>
                    </section>

                    <section class="fp-step" data-step="4">
                        <div class="fp-success-icon">✓</div>
                        <h1>Cap nhat thanh cong</h1>
                        <p>Mat khau da duoc cap nhat thanh cong.</p>
                        <div class="fp-inline-actions">
                            <a class="fp-btn fp-btn-primary" asp-action="DangNhap" asp-controller="KhachHang">Dang nhap ngay</a>
                            <a class="fp-btn fp-btn-secondary" asp-action="Index" asp-controller="Home">Quay ve trang chu</a>
                        </div>
                    </section>
                </form>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/auth-luxury.css" asp-append-version="true" />
}

@section Scripts {
<script>
(() => {
  const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
  const steps = [...document.querySelectorAll('.fp-step')];
  const dots = [...document.querySelectorAll('[data-step-dot]')];
  const getErr = (k) => document.querySelector(`[data-error="${k}"]`);
  let maKh = '';
  let resetToken = '';
  let countdownTimer = null;
  let resendLeft = 60;

  const setStep = (step) => {
    steps.forEach(s => s.classList.toggle('is-active', Number(s.dataset.step) === step));
    dots.forEach((d, i) => d.classList.toggle('is-active', i < step));
  };

  const postForm = async (url, data) => {
    const body = new URLSearchParams(data);
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
      body
    });
    return res.json();
  };

  const otpCode = () => [...document.querySelectorAll('.otp-digit')].map(x => x.value).join('');

  document.getElementById('btnSendOtp').addEventListener('click', async () => {
    getErr('identifier').textContent = '';
    const emailOrUsername = document.getElementById('emailOrUsername').value.trim();
    if (!emailOrUsername) { getErr('identifier').textContent = 'Vui long nhap thong tin tai khoan.'; return; }
    const rs = await postForm('/PasswordRecovery/SendOtp', { emailOrUsername });
    if (!rs.ok) { getErr('identifier').textContent = rs.message || 'Khong the gui OTP.'; return; }
    maKh = rs.maKh;
    document.getElementById('maskedEmail').textContent = rs.maskedEmail || 'email cua ban';
    setStep(2);
    startCountdown(rs.resendAfter || 60);
    document.querySelector('.otp-digit').focus();
  });

  document.getElementById('btnVerifyOtp').addEventListener('click', async () => {
    getErr('otp').textContent = '';
    const otp = otpCode();
    if (otp.length !== 6) { getErr('otp').textContent = 'Vui long nhap du 6 chu so OTP.'; return; }
    const rs = await postForm('/PasswordRecovery/VerifyOtp', { maKh, otp });
    if (!rs.ok) { getErr('otp').textContent = rs.message || 'OTP khong hop le.'; return; }
    resetToken = rs.resetToken;
    setStep(3);
  });

  document.getElementById('btnCompleteReset').addEventListener('click', async () => {
    getErr('password').textContent = '';
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    if (newPassword !== confirmPassword) { getErr('password').textContent = 'Xac nhan mat khau khong khop.'; return; }
    const rs = await postForm('/PasswordRecovery/CompleteReset', { maKh, resetToken, newPassword, confirmPassword });
    if (!rs.ok) { getErr('password').textContent = rs.message || 'Khong the dat lai mat khau.'; return; }
    setStep(4);
    setTimeout(() => { if (rs.redirectUrl) window.location.href = rs.redirectUrl; }, 3500);
  });

  document.getElementById('btnChangeIdentifier').addEventListener('click', () => setStep(1));
  document.getElementById('btnResendOtp').addEventListener('click', async () => {
    if (resendLeft > 0) return;
    const emailOrUsername = document.getElementById('emailOrUsername').value.trim();
    const rs = await postForm('/PasswordRecovery/SendOtp', { emailOrUsername });
    if (!rs.ok) { getErr('otp').textContent = rs.message || 'Khong the gui lai OTP.'; return; }
    startCountdown(rs.resendAfter || 60);
  });

  const startCountdown = (sec) => {
    resendLeft = sec;
    const btn = document.getElementById('btnResendOtp');
    const val = document.getElementById('countdown');
    clearInterval(countdownTimer);
    btn.disabled = true;
    val.textContent = resendLeft;
    countdownTimer = setInterval(() => {
      resendLeft -= 1;
      val.textContent = Math.max(0, resendLeft);
      if (resendLeft <= 0) {
        clearInterval(countdownTimer);
        btn.disabled = false;
      }
    }, 1000);
  };

  document.querySelectorAll('.otp-digit').forEach((el, idx, arr) => {
    el.addEventListener('input', () => {
      el.value = el.value.replace(/\D/g, '').slice(0, 1);
      if (el.value && idx < arr.length - 1) arr[idx + 1].focus();
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !el.value && idx > 0) arr[idx - 1].focus();
    });
    el.addEventListener('paste', (e) => {
      const txt = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
      if (!txt) return;
      e.preventDefault();
      txt.split('').forEach((d, i) => { if (arr[i]) arr[i].value = d; });
      arr[Math.min(txt.length, 5)].focus();
    });
  });

  const strengthBar = document.getElementById('strengthBar');
  document.getElementById('newPassword').addEventListener('input', (e) => {
    const p = e.target.value;
    let score = 0;
    if (p.length >= 8) score++;
    if (/[A-Z]/.test(p)) score++;
    if (/[a-z]/.test(p)) score++;
    if (/\d/.test(p)) score++;
    if (/[^A-Za-z0-9]/.test(p)) score++;
    strengthBar.style.width = `${Math.min(100, score * 20)}%`;
  });
})();
</script>
}
