@model ECommerceMVC.ViewModels.DangNhapVM
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="cart-table-area section-padding-100">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-6">
                <div class="checkout_details_area mt-50 clearfix">
                    <div class="cart-title">
                        <h2>Đăng nhập khách hàng</h2>
                    </div>

                    <form asp-action="DangNhap" method="post">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="MaKh" class="mb-2"></label>
                            <input asp-for="MaKh" class="form-control" placeholder="Nhập mã khách hàng" />
                            <span asp-validation-for="MaKh" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhau" class="mb-2"></label>
                            <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="GhiNho" class="form-check-input" />
                            <label asp-for="GhiNho" class="form-check-label"></label>
                        </div>

                        <button type="submit" class="btn amado-btn w-100">Đăng nhập</button>
                    </form>

                    <div class="mt-3 text-center">
                        Chưa có tài khoản?
                        <a asp-action="DangKy" asp-controller="KhachHang">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
