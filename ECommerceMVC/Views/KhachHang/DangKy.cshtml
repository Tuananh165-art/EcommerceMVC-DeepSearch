@model ECommerceMVC.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="cart-table-area section-padding-100">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="checkout_details_area mt-50 clearfix">
                    <div class="cart-title">
                        <h2>Đăng ký thành viên</h2>
                    </div>

                    <form asp-action="DangKy" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaKh" class="mb-2"></label>
                                <input asp-for="MaKh" class="form-control" placeholder="Tên đăng nhập" />
                                <span asp-validation-for="MaKh" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MatKhau" class="mb-2"></label>
                                <input asp-for="MatKhau" class="form-control" placeholder="Mật khẩu" />
                                <span asp-validation-for="MatKhau" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="HoTen" class="mb-2"></label>
                                <input asp-for="HoTen" class="form-control" placeholder="Họ và tên" />
                                <span asp-validation-for="HoTen" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgaySinh" class="mb-2"></label>
                                <input asp-for="NgaySinh" class="form-control" />
                                <span asp-validation-for="NgaySinh" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DienThoai" class="mb-2"></label>
                                <input asp-for="DienThoai" class="form-control" placeholder="Số điện thoại" />
                                <span asp-validation-for="DienThoai" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="mb-2"></label>
                                <input asp-for="Email" class="form-control" placeholder="Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="DiaChi" class="mb-2"></label>
                                <input asp-for="DiaChi" class="form-control" placeholder="Địa chỉ" />
                                <span asp-validation-for="DiaChi" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="Hinh" class="mb-2">Hình đại diện</label>
                                <input type="file" name="Hinh" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check">
                                    <input asp-for="GioiTinh" class="form-check-input" />
                                    <label class="form-check-label" asp-for="GioiTinh">Nam</label>
                                </div>
                            </div>

                            <div class="col-12 mt-2">
                                <button type="submit" class="btn amado-btn w-100">Đăng ký</button>
                            </div>
                        </div>
                    </form>

                    <div class="mt-3 text-center">
                        Đã có tài khoản?
                        <a asp-action="DangNhap" asp-controller="KhachHang">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
