@{
    ViewData["Title"] = "Showroom 3D nội thất";
    Layout = "_LayoutCustomer";
}

@section Styles {
    <style>
        .showroom-lux {
            position: relative;
            overflow: hidden;
            padding: clamp(2.6rem, 6vw, 5rem) 0 clamp(3rem, 6vw, 5.2rem);
            min-height: 76vh;
            background:
                radial-gradient(1200px 380px at 78% 14%, rgba(196, 157, 120, 0.22), transparent 62%),
                radial-gradient(900px 320px at 14% 88%, rgba(86, 63, 46, 0.12), transparent 72%),
                linear-gradient(160deg, #f5ecde 0%, #efe2d1 48%, #f8f1e6 100%);
        }

        .showroom-lux::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255, 250, 241, 0.58), rgba(255, 250, 241, 0.04));
            pointer-events: none;
        }

        .showroom-shell {
            position: relative;
            z-index: 1;
            max-width: 1360px;
            margin: 0 auto;
            padding: 0 clamp(1rem, 3vw, 2rem);
        }

        .showroom-grid {
            display: grid;
            grid-template-columns: minmax(0, 0.95fr) minmax(440px, 1fr);
            gap: clamp(1.4rem, 4vw, 3.1rem);
            align-items: center;
        }

        .showroom-copy {
            display: grid;
            gap: 1.2rem;
            max-width: 640px;
        }

        .showroom-kicker {
            display: inline-flex;
            width: fit-content;
            align-items: center;
            padding: 0.5rem 0.95rem;
            border-radius: 999px;
            border: 1px solid rgba(99, 74, 54, 0.2);
            background: rgba(255, 250, 244, 0.72);
            color: #76583f;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            font-size: 0.72rem;
            font-weight: 700;
            backdrop-filter: blur(8px);
        }

        .showroom-title {
            margin: 0;
            font-size: clamp(2.2rem, 4.8vw, 4.45rem);
            line-height: 0.97;
            letter-spacing: -0.03em;
            color: #1f1812;
            text-wrap: balance;
        }

        .showroom-desc {
            margin: 0;
            color: #625649;
            line-height: 1.75;
            font-size: clamp(1rem, 1.2vw, 1.1rem);
            max-width: 58ch;
        }

        .showroom-actions {
            display: flex;
            align-items: center;
            gap: 0.78rem;
            flex-wrap: wrap;
            margin-top: 0.45rem;
        }

        .showroom-btn {
            min-height: 50px;
            padding: 0 1.35rem;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 650;
            text-decoration: none;
            transition: transform .22s ease, box-shadow .22s ease, background .22s ease, color .22s ease;
        }

        .showroom-btn-primary {
            border: 1px solid rgba(89, 62, 38, 0.2);
            background: linear-gradient(140deg, #b98357, #d5af84);
            color: #fff8ed;
            box-shadow: 0 14px 32px rgba(117, 77, 48, 0.28);
        }

        .showroom-btn-primary:hover {
            transform: translateY(-1px);
            color: #fff;
            box-shadow: 0 18px 36px rgba(117, 77, 48, 0.34);
        }

        .showroom-btn-secondary {
            border: 1px solid rgba(98, 72, 49, 0.24);
            background: rgba(255, 250, 242, 0.62);
            color: #2f2419;
            backdrop-filter: blur(8px);
        }

        .showroom-btn-secondary:hover {
            transform: translateY(-1px);
            color: #2b2118;
            background: rgba(255, 250, 242, 0.94);
        }

        .showroom-note {
            margin-top: 0.1rem;
            font-size: 0.88rem;
            color: #7e6d5f;
        }

        .showroom-stage {
            border-radius: 1.8rem;
            border: 1px solid rgba(115, 84, 57, 0.16);
            background: linear-gradient(150deg, rgba(255, 249, 240, 0.7), rgba(246, 232, 216, 0.55));
            backdrop-filter: blur(14px);
            box-shadow: 0 28px 72px rgba(61, 43, 29, 0.22);
            padding: 1rem;
            display: grid;
            gap: 0.9rem;
        }

        .showroom-frame-wrap {
            border-radius: 1.15rem;
            overflow: hidden;
            border: 1px solid rgba(113, 84, 60, 0.16);
            background: #17120f;
            position: relative;
            aspect-ratio: 16 / 9;
        }

        .showroom-frame {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
            display: block;
        }

        .showroom-overlay {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 0.7rem;
            align-items: start;
            margin-top: 0.62rem;
        }

        .showroom-floating {
            border-radius: 0.9rem;
            border: 1px solid rgba(255, 247, 236, 0.18);
            background: rgba(22, 16, 13, 0.66);
            color: rgba(255, 248, 239, 0.9);
            backdrop-filter: blur(10px);
            padding: 0.52rem 0.68rem;
            font-size: 0.75rem;
            max-width: 440px;
        }

        .showroom-floating strong {
            display: block;
            font-size: 0.82rem;
            color: #f6e7d2;
            margin-bottom: 0.06rem;
        }

        .showroom-floating-chip {
            align-self: start;
            border-radius: 999px;
            border: 1px solid rgba(255, 246, 230, 0.22);
            background: rgba(23, 16, 12, 0.74);
            color: #e8d4bb;
            padding: 0.36rem 0.72rem;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-weight: 700;
        }

        .showroom-controls {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.62rem;
        }

        .showroom-control {
            border-radius: 0.88rem;
            border: 1px solid rgba(105, 76, 52, 0.15);
            background: rgba(255, 250, 242, 0.64);
            padding: 0.7rem 0.75rem;
            display: grid;
            gap: 0.08rem;
            box-shadow: 0 8px 22px rgba(66, 48, 33, 0.08);
        }

        .showroom-control strong {
            font-size: 0.82rem;
            color: #2f2419;
            font-weight: 700;
        }

        .showroom-control span {
            font-size: 0.78rem;
            color: #716254;
            line-height: 1.35;
        }

        .showroom-benefits {
            padding: clamp(2.2rem, 5vw, 4rem) 0 clamp(2.4rem, 5vw, 4.4rem);
            background: linear-gradient(180deg, #f9f2e8 0%, #f8f3ea 100%);
        }

        .showroom-benefit-grid {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 clamp(1rem, 3vw, 2rem);
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }

        .showroom-benefit {
            border-radius: 1rem;
            border: 1px solid rgba(108, 79, 55, 0.14);
            background: rgba(255, 250, 242, 0.75);
            box-shadow: 0 15px 36px rgba(64, 46, 30, 0.1);
            padding: 1.15rem 1.15rem 1.1rem;
            transition: transform .24s ease, box-shadow .24s ease;
        }

        .showroom-benefit:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 44px rgba(64, 46, 30, 0.14);
        }

        .showroom-benefit h3 {
            margin: 0 0 0.45rem;
            font-size: 1.25rem;
            line-height: 1.2;
            color: #261b13;
        }

        .showroom-benefit p {
            margin: 0;
            color: #6f6256;
            line-height: 1.6;
            font-size: 0.95rem;
        }

        @@media (max-width: 1199.98px) {
            .showroom-grid {
                grid-template-columns: 1fr;
            }

            .showroom-copy {
                max-width: none;
            }
        }

        @@media (max-width: 991.98px) {
            .showroom-controls,
            .showroom-benefit-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .showroom-title {
                font-size: clamp(2rem, 11vw, 3rem);
                line-height: 1.02;
            }

            .showroom-overlay { grid-template-columns: 1fr; }

            .showroom-floating {
                max-width: none;
            }
        }
    </style>
}

<section class="showroom-lux">
    <div class="showroom-shell">
        <div class="showroom-grid">
            <div class="showroom-copy">
                <span class="showroom-kicker">Immersive Luxury Showroom</span>
                <h1 class="showroom-title">Khám phá nội thất 3D với chiều sâu vật liệu và ánh sáng chân thực.</h1>
                <p class="showroom-desc">
                    Xoay góc nhìn, phóng to bề mặt vải, gỗ và kim loại trong không gian sống mô phỏng theo ngôn ngữ
                    thiết kế cao cấp. Trải nghiệm mượt mà giúp bạn tự tin trước khi chọn mua.
                </p>

                <div class="showroom-actions">
                    <a class="showroom-btn showroom-btn-primary" href="/showroom3d/index.html" target="_blank" rel="noopener">
                        Mở toàn màn hình 3D
                    </a>
                    <a class="showroom-btn showroom-btn-secondary" asp-controller="HangHoa" asp-action="Index">
                        Xem bộ sưu tập
                    </a>
                </div>
                <p class="showroom-note">Mẹo: Chọn tone sofa neutral/ivory trong bảng màu để cảm giác luxury đồng nhất hơn.</p>
            </div>

            <aside class="showroom-stage">
                <div class="showroom-frame-wrap">
                    <iframe id="showroomFrame" class="showroom-frame" src="/showroom3d/index.html?embed=1" title="Showroom 3D luxury interior" loading="lazy" allowfullscreen></iframe>
                </div>
                <div class="showroom-overlay">
                    <div class="showroom-floating">
                        <strong>Showroom Guide</strong>
                        Bắt đầu với không gian Villa hoặc Parisian, sau đó chuyển màu sofa sang cream để xem độ hài hòa ánh sáng.
                    </div>
                    <div class="showroom-floating-chip">Live 3D Render</div>
                </div>

                <div class="showroom-controls">
                    <div class="showroom-control">
                        <strong>Kéo chuột</strong>
                        <span>Xoay camera quanh sản phẩm.</span>
                    </div>
                    <div class="showroom-control">
                        <strong>Cuộn chuột</strong>
                        <span>Zoom chi tiết vật liệu và đường nét.</span>
                    </div>
                    <div class="showroom-control">
                        <strong>Auto rotate</strong>
                        <span>Dừng thao tác để xem góc trình diễn.</span>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function hideShowroomDock() {
            var frame = document.getElementById("showroomFrame");
            if (!frame) return;

            function forceHideDock() {
                try {
                    var doc = frame.contentDocument || (frame.contentWindow && frame.contentWindow.document);
                    if (!doc) return;
                    var dock = doc.getElementById("customizer-dock");
                    if (dock) {
                        dock.style.display = "none";
                    }
                } catch (_) { }
            }

            frame.addEventListener("load", function () {
                forceHideDock();
                var ticks = 0;
                var timer = setInterval(function () {
                    forceHideDock();
                    ticks++;
                    if (ticks > 120) clearInterval(timer);
                }, 100);
            });
        })();
    </script>
}

<section class="showroom-benefits">
    <div class="showroom-benefit-grid">
        <article class="showroom-benefit">
            <h3>Không khí studio cao cấp</h3>
            <p>Ánh sáng ấm và nền màu trung tính giúp sản phẩm nổi bật mà vẫn giữ cảm giác tinh tế, giống một showroom nội thất thực tế.</p>
        </article>
        <article class="showroom-benefit">
            <h3>Hỗ trợ quyết định nhanh</h3>
            <p>Nhìn thấy tỷ lệ, chất liệu và phối cảnh ngay trong 3D giúp bạn rút ngắn thời gian chọn lựa trước khi vào trang chi tiết sản phẩm.</p>
        </article>
        <article class="showroom-benefit">
            <h3>Tương tác trực quan, dễ dùng</h3>
            <p>Panel hướng dẫn tối giản và rõ ràng giúp người mới tiếp cận showroom dễ dàng mà không bị quá tải bởi controls.</p>
        </article>
    </div>
</section>
