@model ECommerceMVC.ViewModels.ChiTietDonHangVM
@{
    ViewData["Title"] = $"Chi Tiết Đơn Hàng #{Model.MaHd} | DEEPSEARCH";
}

<div class="order-detail-section py-5">
    <div class="container py-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-5 reveal">
            <ol class="breadcrumb bg-transparent p-0 m-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary hover-primary transition-base">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="HangHoa" asp-action="Index" class="text-secondary hover-primary transition-base">Shop</a></li>
                <li class="breadcrumb-item"><a asp-action="LichSuDonHang" class="text-secondary hover-primary transition-base">Lịch sử đơn hàng</a></li>
                <li class="breadcrumb-item active text-primary font-weight-semibold" aria-current="page">Chi tiết đơn hàng</li>
            </ol>
        </nav>

        <div class="d-flex align-items-center gap-3 mb-4 reveal">
            <h2 class="font-heading text-3xl mb-0">Đơn hàng #@Model.MaHd</h2>
        </div>

        <div class="row g-4">
            <!-- Order Items (Left) -->
            <div class="col-12 col-lg-8 reveal-left">
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="glass-card p-3 transition-base hover-shadow-md" style="border-radius: var(--radius-lg);">
                            <div class="row align-items-center g-3">
                                <!-- Image -->
                                <div class="col-auto">
                                    <div class="overflow-hidden" style="border-radius: var(--radius-md); width: 72px; height: 72px; background-color: var(--bg-secondary);">
                                        <img src="@item.HinhUrl" class="w-100 h-100 object-fit-cover hover-scale transition-smooth" alt="@item.TenHh" />
                                    </div>
                                </div>

                                <!-- Details -->
                                <div class="col">
                                    <h6 class="font-heading text-base mb-1 text-primary">@item.TenHh</h6>
                                    <span class="text-tertiary text-xs">Đơn giá: @($"{item.DonGia:N0} VND")</span>
                                </div>

                                <!-- Quantity -->
                                <div class="col-auto text-center px-3">
                                    <span class="text-secondary text-xs d-block mb-0.5">Số lượng</span>
                                    <strong class="text-primary text-sm">x@item.SoLuong</strong>
                                </div>

                                <!-- Total -->
                                <div class="col-auto text-end px-3">
                                    <span class="text-secondary text-xs d-block mb-0.5">Thành tiền</span>
                                    <span class="text-gradient text-sm font-weight-bold">
                                        @($"{item.ThanhTien:N0} VND")
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Receipt & Summary (Right) -->
            <div class="col-12 col-lg-4 reveal-right">
                <div class="glass-card p-4 position-sticky" style="border-radius: var(--radius-xl); top: calc(var(--navbar-height) + 20px);">
                    <h4 class="font-heading text-xl mb-4 border-bottom border-color pb-3">Chi tiết thanh toán</h4>
                    
                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center text-sm">
                            <span class="text-secondary">Tạm tính</span>
                            <span class="text-primary font-weight-semibold">@($"{Model.Subtotal:N0} VND")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center text-sm">
                            <span class="text-secondary">Phí vận chuyển</span>
                            <span class="text-primary font-weight-semibold">@($"{Model.PhiVanChuyen:N0} VND")</span>
                        </div>
                        <div class="border-top border-color pt-3 mt-1 d-flex justify-content-between align-items-center">
                            <span class="text-primary font-weight-bold">Tổng thanh toán</span>
                            <span class="text-gradient text-lg font-weight-extrabold">@($"{Model.Total:N0} VND")</span>
                        </div>
                    </div>

                    <a asp-action="LichSuDonHang" class="btn btn-outline-modern w-100 py-3 d-flex align-items-center justify-content-center gap-2" style="border-radius: var(--radius-md);">
                        <i data-icon="arrow-left" data-size="18px"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
