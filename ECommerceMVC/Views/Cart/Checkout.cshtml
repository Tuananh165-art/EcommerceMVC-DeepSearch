@model ECommerceMVC.ViewModels.CheckoutVM
@using ECommerceMVC.ViewModels
@{
    ViewData["Title"] = "Thanh toán COD";
    var cart = ViewBag.Cart as List<CartItem> ?? new List<CartItem>();
    var subtotal = cart.Sum(x => x.ThanhTien);
    var total = subtotal + Model.PhiVanChuyen;
}

<div class="cart-table-area section-padding-100">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-lg-8">
                <div class="checkout_details_area mt-50 clearfix">
                    <div class="cart-title">
                        <h2>Thông tin giao hàng (COD)</h2>
                    </div>

                    <form asp-action="Checkout" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaKh" class="mb-2"></label>
                                <input asp-for="MaKh" class="form-control" readonly />
                                <small class="text-muted">Mã khách hàng được lấy theo tài khoản đăng nhập.</small>
                                <span asp-validation-for="MaKh" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="HoTen" class="mb-2"></label>
                                <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên người nhận" />
                                <span asp-validation-for="HoTen" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DienThoai" class="mb-2"></label>
                                <input asp-for="DienThoai" class="form-control" placeholder="Nhập số điện thoại" />
                                <span asp-validation-for="DienThoai" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="mb-2"></label>
                                <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="DiaChi" class="mb-2"></label>
                                <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ nhận hàng" />
                                <span asp-validation-for="DiaChi" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="GhiChu" class="mb-2"></label>
                                <textarea asp-for="GhiChu" class="form-control w-100" cols="30" rows="5" placeholder="Ghi chú đơn hàng (nếu có)"></textarea>
                                <span asp-validation-for="GhiChu" class="text-danger"></span>
                            </div>

                            <div class="col-12 mb-4">
                                <div class="payment-method">
                                    <div class="custom-control custom-checkbox mr-sm-2">
                                        <input type="checkbox" class="custom-control-input" id="cod" checked disabled>
                                        <label class="custom-control-label" for="cod">Thanh toán khi nhận hàng (COD)</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn amado-btn w-100">Xác nhận đặt hàng COD</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="cart-summary mt-50">
                    <h5>Đơn hàng của bạn</h5>
                    <ul class="summary-table">
                        <li><span>Tạm tính:</span> <span>$@subtotal</span></li>
                        <li><span>Phí giao:</span> <span>$@Model.PhiVanChuyen</span></li>
                        <li><span>Tổng:</span> <span>$@total</span></li>
                    </ul>
                    <p class="mb-0">Tổng số sản phẩm: @cart.Sum(x => x.SoLuong)</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
