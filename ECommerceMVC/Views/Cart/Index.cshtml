@model IEnumerable<ECommerceMVC.ViewModels.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng | DEEPSEARCH";
    var subtotal = Model?.Sum(x => x.ThanhTien) ?? 0;
}

<div class="cart-section py-5">
    <div class="container py-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-5 reveal">
            <ol class="breadcrumb bg-transparent p-0 m-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary hover-primary transition-base">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="HangHoa" asp-action="Index" class="text-secondary hover-primary transition-base">Shop</a></li>
                <li class="breadcrumb-item active text-primary font-weight-semibold" aria-current="page">Giỏ hàng</li>
            </ol>
        </nav>

        <div class="d-flex align-items-center justify-content-between mb-4 reveal">
            <h2 class="font-heading text-3xl mb-0">Giỏ hàng của bạn</h2>
            @if (Model != null && Model.Any())
            {
                <span class="badge bg-secondary-light text-primary px-3 py-2 rounded-pill font-weight-semibold">
                    @Model.Sum(x => x.SoLuong) sản phẩm
                </span>
            }
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                <!-- Cart Items List (Left) -->
                <div class="col-12 col-lg-8 reveal-left">
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in Model)
                        {
                            <div class="glass-card p-3 transition-base hover-shadow-md position-relative" style="border-radius: var(--radius-lg);">
                                <div class="row align-items-center g-3">
                                    <!-- Image -->
                                    <div class="col-auto">
                                        <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh" class="d-block overflow-hidden" style="border-radius: var(--radius-md); width: 88px; height: 88px; background-color: var(--bg-secondary);">
                                            <img src="@item.HinhUrl" class="w-100 h-100 object-fit-cover hover-scale transition-smooth" alt="@item.TenHH" />
                                        </a>
                                    </div>

                                    <!-- Description & Details -->
                                    <div class="col col-md-5">
                                        <h5 class="font-heading text-base mb-1">
                                            <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh" class="text-primary hover-primary transition-base">
                                                @item.TenHH
                                            </a>
                                        </h5>
                                        <p class="text-tertiary text-xs mb-0">Mã SP: #@item.MaHh</p>
                                        <span class="text-gradient font-weight-semibold text-sm d-md-none mt-1 d-block">
                                            @($"{item.DonGia:N0} VND")
                                        </span>
                                    </div>

                                    <!-- Price (Desktop only) -->
                                    <div class="col-md-2 d-none d-md-block text-center">
                                        <span class="text-secondary text-sm font-weight-semibold">
                                            @($"{item.DonGia:N0} VND")
                                        </span>
                                    </div>

                                    <!-- Quantity Stepper Form -->
                                    <div class="col-auto col-md-2">
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.MaHh" />
                                            
                                            <div class="d-flex align-items-center border border-color bg-card overflow-hidden" style="border-radius: var(--radius-md); height: 38px;">
                                                <button type="submit" class="btn border-0 px-2 h-100 d-flex align-items-center justify-content-center hover-primary transition-base" name="quantity" value="@(item.SoLuong - 1)" @(item.SoLuong <= 1 ? "disabled" : "")>
                                                    <i data-icon="minus" data-size="12px"></i>
                                                </button>
                                                <input type="number" class="text-center border-0 bg-transparent font-weight-semibold text-primary text-sm" id="qty-@item.MaHh" value="@item.SoLuong" readonly style="width: 36px; outline: none;" />
                                                <button type="submit" class="btn border-0 px-2 h-100 d-flex align-items-center justify-content-center hover-primary transition-base" name="quantity" value="@(item.SoLuong + 1)">
                                                    <i data-icon="plus" data-size="12px"></i>
                                                </button>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Delete Item CTA -->
                                    <div class="col-auto ms-auto d-flex align-items-center gap-3">
                                        <span class="text-gradient font-weight-bold text-sm d-none d-md-block" style="min-width: 100px; text-align: right;">
                                            @($"{item.ThanhTien:N0} VND")
                                        </span>
                                        <a asp-controller="Cart" asp-action="RemoveCart" asp-route-id="@item.MaHh" class="btn btn-ghost hover-danger p-2" style="border-radius: var(--radius-full);" title="Xóa khỏi giỏ hàng">
                                            <i data-icon="trash" data-size="18px"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Order Summary (Right) -->
                <div class="col-12 col-lg-4 reveal-right">
                    <div class="glass-card p-4 position-sticky" style="border-radius: var(--radius-xl); top: calc(var(--navbar-height) + 20px);">
                        <h4 class="font-heading text-xl mb-4 border-bottom border-color pb-3">Hóa đơn tóm tắt</h4>
                        
                        <div class="d-flex flex-column gap-3 mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary text-sm">Tạm tính</span>
                                <span class="text-primary font-weight-semibold">@($"{subtotal:N0} VND")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary text-sm">Phí vận chuyển</span>
                                <span class="text-success text-sm font-weight-semibold">Miễn phí</span>
                            </div>
                            <div class="border-top border-color pt-3 mt-1 d-flex justify-content-between align-items-center">
                                <span class="text-primary font-weight-bold">Tổng thanh toán</span>
                                <span class="text-gradient text-xl font-weight-extrabold">@($"{subtotal:N0} VND")</span>
                            </div>
                        </div>

                        <a asp-controller="Cart" asp-action="Checkout" class="btn btn-gradient w-100 py-3 d-flex align-items-center justify-content-center gap-2 shadow-glow hover-shadow-glow" style="border-radius: var(--radius-md);">
                            <i data-icon="credit-card" data-size="18px"></i> Tiến hành đặt hàng
                        </a>

                        <div class="mt-4 text-center">
                            <a asp-controller="HangHoa" asp-action="Index" class="text-secondary hover-primary text-xs transition-base d-inline-flex align-items-center gap-1">
                                <i data-icon="arrow-left" data-size="12px"></i> Tiếp tục mua sắm
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Empty Cart -->
            <div class="text-center py-5 reveal">
                <div class="glass-card p-5 mx-auto max-width-lg" style="border-radius: var(--radius-xl); max-width: 600px;">
                    <div class="accent-orb accent-orb-primary" style="top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120px; height: 120px; opacity: 0.1; filter: blur(30px);"></div>
                    <i data-icon="shopping-bag" data-size="60px" class="text-gradient mb-4 d-inline-block animate-bounce"></i>
                    <h3 class="font-heading text-2xl mb-2">Giỏ hàng của bạn đang trống</h3>
                    <p class="text-secondary mb-4">Có vẻ như bạn chưa chọn được sản phẩm lifestyle phù hợp nào cho nhu cầu hiện tại của mình.</p>
                    <a asp-controller="HangHoa" asp-action="Index" class="btn btn-gradient px-4 py-3 d-inline-flex align-items-center gap-2" style="border-radius: var(--radius-md);">
                        <i data-icon="arrow-right" data-size="16px"></i> Xem bộ sưu tập sản phẩm
                    </a>
                </div>
            </div>
        }
    </div>
</div>
