@model IEnumerable<ECommerceMVC.ViewModels.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var subtotal = Model.Sum(x => x.ThanhTien);
}

<div class="cart-table-area section-padding-100">
    <div class="container-fluid">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
        }

        <div class="row">
            <div class="col-12 col-lg-8">
                <div class="cart-title mt-50">
                    <h2>Shopping Cart</h2>
                </div>

                <div class="cart-table clearfix">
                    <table class="table table-responsive">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="cart_product_img">
                                            <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh">
                                                <img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHH" />
                                            </a>
                                        </td>
                                        <td class="cart_product_desc">
                                            <h5>@item.TenHH</h5>
                                        </td>
                                        <td class="price"><span>$@item.DonGia</span></td>
                                        <td class="qty"><span>@item.SoLuong</span></td>
                                        <td class="price"><span>$@item.ThanhTien</span></td>
                                        <td>
                                            <a asp-action="RemoveCart" asp-route-id="@item.MaHh" class="btn btn-sm btn-danger">Xóa</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">Giỏ hàng đang trống.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="cart-summary">
                    <h5>Cart Total</h5>
                    <ul class="summary-table">
                        <li><span>subtotal:</span> <span>$@subtotal</span></li>
                        <li><span>delivery:</span> <span>Free</span></li>
                        <li><span>total:</span> <span>$@subtotal</span></li>
                    </ul>
                    <div class="cart-btn mt-100">
                        <a asp-action="Checkout" class="btn amado-btn w-100 @(Model.Any() ? "" : "disabled")">Checkout COD</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
