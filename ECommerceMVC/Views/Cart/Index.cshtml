@model IEnumerable<ECommerceMVC.ViewModels.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var subtotal = Model.Sum(x => x.ThanhTien);
}

<div class="cart-table-area section-padding-100">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-lg-8">
                <div class="cart-title mt-50">
                    <h2>Giỏ hàng của bạn</h2>
                </div>

                <div class="cart-table clearfix">
                    <table class="table table-responsive">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="cart_product_img" style="width: 120px;">
                                            <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh">
                                                <img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHH" style="width: 100px; height: 100px; object-fit: cover;" />
                                            </a>
                                        </td>
                                        <td class="cart_product_desc">
                                            <h5 class="mb-0">@item.TenHH</h5>
                                        </td>
                                        <td class="price"><span>$@item.DonGia</span></td>
                                        <td class="qty"><span>@item.SoLuong</span></td>
                                        <td class="price"><span>$@item.ThanhTien</span></td>
                                        <td>
                                            <a asp-action="RemoveCart" asp-route-id="@item.MaHh" class="btn btn-sm" style="border:1px solid #fbb710;color:#fbb710;">Xóa</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4">Giỏ hàng đang trống.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="cart-summary">
                    <h5>Tổng giỏ hàng</h5>
                    <ul class="summary-table">
                        <li><span>Tạm tính:</span> <span>$@subtotal</span></li>
                        <li><span>Phí giao:</span> <span>Free</span></li>
                        <li><span>Tổng:</span> <span>$@subtotal</span></li>
                    </ul>
                    <div class="cart-btn mt-80">
                        @if (Model.Any())
                        {
                            <a asp-action="Checkout" class="btn amado-btn w-100">Thanh toán COD</a>
                        }
                        else
                        {
                            <button type="button" class="btn amado-btn w-100" disabled>Thanh toán COD</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
