@model AdminProductFormVM
@{ Layout = "_AdminLayout"; ViewData["Title"] = Model.MaHh == 0 ? "Thêm sản phẩm" : "Sửa sản phẩm"; }
<div class="admin-card">
<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="MaHh" /><input type="hidden" asp-for="Hinh" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="TenHh" class="form-label"></label><input asp-for="TenHh" class="form-control" /><span asp-validation-for="TenHh" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="TenAlias" class="form-label"></label><input asp-for="TenAlias" class="form-control" placeholder="SKU duy nhất" /><span asp-validation-for="TenAlias" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="DonGia" class="form-label"></label><input asp-for="DonGia" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="MaLoai" class="form-label"></label><select asp-for="MaLoai" class="form-select" asp-items="ViewBag.Categories"></select></div>
        <div class="col-md-4"><label asp-for="MaNcc" class="form-label"></label><select asp-for="MaNcc" class="form-select" asp-items="ViewBag.Suppliers"></select></div>
        <div class="col-md-2"><label asp-for="SoLuongTon" class="form-label"></label><input asp-for="SoLuongTon" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="LowStockThreshold" class="form-label"></label><input asp-for="LowStockThreshold" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="MauSac" class="form-label"></label><input asp-for="MauSac" class="form-control" placeholder="Đỏ, xanh..." /></div>
        <div class="col-md-3"><label asp-for="KichThuoc" class="form-label"></label><input asp-for="KichThuoc" class="form-control" placeholder="S/M/L hoặc 80x120" /></div>
        <div class="col-md-3"><label asp-for="ChatLieu" class="form-label"></label><input asp-for="ChatLieu" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="BaoHanh" class="form-label"></label><input asp-for="BaoHanh" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="PhongCach" class="form-label"></label><input asp-for="PhongCach" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="GiamGia" class="form-label"></label><input asp-for="GiamGia" class="form-control" step="0.01" /></div>
        <div class="col-md-3"><label asp-for="NgaySx" class="form-label"></label><input asp-for="NgaySx" type="date" class="form-control" /></div>
        <div class="col-md-3 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsVisible" class="form-check-input" /><label asp-for="IsVisible" class="form-check-label"></label></div></div>
        <div class="col-md-6"><label asp-for="MoTaDonVi" class="form-label"></label><input asp-for="MoTaDonVi" class="form-control" maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label">Ảnh sản phẩm</label><input type="file" name="hinhUpload" class="form-control" accept="image/*" />@if (!string.IsNullOrWhiteSpace(Model.Hinh)) { <div class="mt-2"><img class="product-thumb" src="@MyUtil.GetHangHoaImageUrl(Model.Hinh, Model.MaHh)" /> <span class="small text-muted">@Model.Hinh</span></div> }</div>
        <div class="col-12"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" class="form-control" rows="7" placeholder="Mô tả chi tiết sản phẩm, admin metadata sẽ được lưu tự động"></textarea></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Lưu sản phẩm</button><a class="btn btn-outline-secondary" asp-action="Products">Hủy</a></div>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
