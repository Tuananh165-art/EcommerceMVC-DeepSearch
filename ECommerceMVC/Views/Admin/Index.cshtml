@model AdminDashboardVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bảng điều khiển tổng quan";
    var maxDaily = Math.Max(1, Model.DailyRevenue.Any() ? Model.DailyRevenue.Max(x => x.Value) : 1);
    var maxMonthly = Math.Max(1, Model.MonthlyRevenue.Any() ? Model.MonthlyRevenue.Max(x => x.Value) : 1);
}

<style>
    /* ===== LUXURY DASHBOARD CUSTOM STYLES ===== */
    .dashboard-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* Action Banner */
    .action-banner {
        padding: 1.2rem;
        background: rgba(255, 252, 248, 0.85);
        border: 1px solid rgba(184, 134, 86, 0.18);
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(89, 57, 34, 0.04);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
    }

    .action-banner-title {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 800;
        color: #7e6958;
        margin-right: 0.5rem;
    }

    .btn-luxury-action {
        padding: 0.65rem 1.2rem;
        font-size: 0.88rem;
        font-weight: 700;
        border-radius: 0.8rem;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        box-shadow: 0 4px 12px rgba(89, 57, 34, 0.03);
    }

    .btn-luxury-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(89, 57, 34, 0.08);
    }

    .btn-primary-luxury {
        background: linear-gradient(135deg, #7b5236, #b88656);
        color: #ffffff !important;
        border: 1px solid #7b5236;
    }
    .btn-primary-luxury:hover {
        background: linear-gradient(135deg, #5f3f29, #9c6e43);
        border-color: #5f3f29;
    }

    .btn-outline-luxury {
        background: #ffffff;
        color: #7b5236 !important;
        border: 1.5px solid rgba(123, 82, 54, 0.3);
    }
    .btn-outline-luxury:hover {
        background: rgba(184, 134, 86, 0.06);
        border-color: #7b5236;
    }

    /* Stat Cards Grid */
    .stat-card-luxury {
        position: relative;
        padding: 1.3rem;
        border-radius: 1.25rem;
        border: 1px solid rgba(184, 134, 86, 0.15);
        background: rgba(255, 252, 248, 0.94);
        box-shadow: 0 10px 30px rgba(89, 57, 34, 0.05);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 125px;
    }

    .stat-card-luxury:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 36px rgba(89, 57, 34, 0.1);
        border-color: rgba(184, 134, 86, 0.35);
    }

    .stat-card-luxury::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--accent-gradient, linear-gradient(180deg, #7b5236, #b88656));
    }

    .stat-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .stat-label-luxury {
        color: #7e6958;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 800;
    }

    .stat-icon-box {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--icon-bg, rgba(184, 134, 86, 0.1));
        color: var(--icon-color, #7b5236);
        flex-shrink: 0;
    }

    .stat-value-luxury {
        font-size: clamp(1.4rem, 2.2vw, 1.85rem);
        font-weight: 850;
        color: #2c2119;
        margin-top: 0.4rem;
        line-height: 1.1;
        letter-spacing: -0.01em;
    }

    .stat-hint-luxury {
        font-size: 0.78rem;
        color: #8a7565;
        margin-top: 0.4rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-weight: 550;
    }

    /* Small secondary stat cards */
    .sec-stat-card {
        padding: 0.95rem 1.1rem;
        border-radius: 1rem;
        border: 1px solid rgba(184, 134, 86, 0.1);
        background: rgba(255, 252, 248, 0.75);
        box-shadow: 0 6px 20px rgba(89, 57, 34, 0.03);
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .sec-stat-card:hover {
        transform: translateY(-2px);
        background: rgba(255, 252, 248, 0.95);
        border-color: rgba(184, 134, 86, 0.25);
    }

    .sec-stat-info {
        display: flex;
        flex-direction: column;
    }

    .sec-stat-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        color: #8a7565;
    }

    .sec-stat-value {
        font-size: 1.15rem;
        font-weight: 800;
        color: #2c2119;
        margin-top: 0.1rem;
    }

    .sec-stat-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--ind-color, #7b5236);
        box-shadow: 0 0 8px var(--ind-color, #7b5236);
    }

    /* Charts Section */
    .chart-card-luxury {
        padding: 1.4rem;
        border-radius: 1.25rem;
        border: 1px solid rgba(184, 134, 86, 0.15);
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(89, 57, 34, 0.04);
        margin-bottom: 1.5rem;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.2rem;
        border-bottom: 1px solid rgba(120, 84, 53, 0.08);
        padding-bottom: 0.6rem;
    }

    .chart-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #433327;
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }

    .chart-container-inner {
        position: relative;
        height: 250px;
        width: 100%;
    }

    /* Ranking / List Cards */
    .list-card-luxury {
        padding: 1.3rem;
        border-radius: 1.25rem;
        border: 1px solid rgba(184, 134, 86, 0.15);
        background: rgba(255, 252, 248, 0.94);
        box-shadow: 0 10px 30px rgba(89, 57, 34, 0.04);
        margin-bottom: 1.25rem;
    }

    .list-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1.5px solid rgba(120, 84, 53, 0.08);
    }

    .list-card-title {
        font-size: 0.98rem;
        font-weight: 800;
        color: #433327;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    /* Ranking styling */
    .top-products-list {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .top-product-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.6rem;
        border-radius: 0.85rem;
        background: #ffffff;
        border: 1px solid rgba(120, 84, 53, 0.05);
        transition: all 0.2s ease;
    }

    .top-product-item:hover {
        transform: translateX(4px);
        border-color: rgba(184, 134, 86, 0.25);
        box-shadow: 0 4px 12px rgba(89, 57, 34, 0.04);
    }

    .rank-medal {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.82rem;
        flex-shrink: 0;
    }
    .rank-1 { background: linear-gradient(135deg, #ffd700, #ffa500); color: #ffffff; box-shadow: 0 4px 10px rgba(255, 165, 0, 0.3); }
    .rank-2 { background: linear-gradient(135deg, #c0c0c0, #a9a9a9); color: #ffffff; box-shadow: 0 4px 10px rgba(169, 169, 169, 0.3); }
    .rank-3 { background: linear-gradient(135deg, #cd7f32, #b87333); color: #ffffff; box-shadow: 0 4px 10px rgba(184, 115, 51, 0.3); }
    .rank-other { background: #f0ede8; color: #7e6958; }

    .product-avatar-luxury {
        width: 44px;
        height: 44px;
        border-radius: 0.6rem;
        object-fit: cover;
        background: #fffdfa;
        border: 1px solid rgba(120, 84, 53, 0.1);
        flex-shrink: 0;
    }

    .product-info-luxury {
        flex-grow: 1;
        min-width: 0;
    }

    .product-name-luxury {
        font-weight: 700;
        font-size: 0.86rem;
        color: #2c2119;
        margin-bottom: 0.1rem;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .product-sale-count {
        font-size: 0.76rem;
        color: #7e6958;
    }

    .product-revenue-luxury {
        font-weight: 800;
        font-size: 0.86rem;
        color: #7b5236;
        text-align: right;
        flex-shrink: 0;
    }

    /* Low Stock Items Progress Bar */
    .progress-luxury {
        height: 6px;
        border-radius: 999px;
        background-color: #f0ede8;
        overflow: hidden;
        margin-top: 0.35rem;
    }

    .progress-bar-luxury {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #b88656, #7b5236);
        transition: width 0.4s ease;
    }
    .progress-bar-danger {
        background: linear-gradient(90deg, #dd6b6b, #b74040);
    }

    /* Order Row Items */
    .order-item-luxury {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.68rem 0.6rem;
        border-bottom: 1px dashed rgba(120, 84, 53, 0.08);
    }
    .order-item-luxury:last-child {
        border-bottom: none;
    }

    .order-meta {
        display: flex;
        flex-direction: column;
    }

    .order-code {
        font-weight: 800;
        font-size: 0.86rem;
        color: #7b5236;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .order-code:hover {
        color: #b88656;
    }

    .order-time {
        font-size: 0.72rem;
        color: #8a7565;
        margin-top: 0.1rem;
    }

    .order-customer {
        font-size: 0.8rem;
        font-weight: 600;
        color: #2c2119;
    }

    .order-total-block {
        text-align: right;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.2rem;
    }

    .order-total {
        font-weight: 800;
        font-size: 0.86rem;
        color: #2c2119;
    }
</style>

<div class="dashboard-container">
    <!-- Action Banner -->
    <div class="action-banner">
        <span class="action-banner-title">Thao tác nhanh:</span>
        <a class="btn btn-luxury-action btn-primary-luxury" asp-action="ProductCreate">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Thêm sản phẩm
        </a>
        <a class="btn btn-luxury-action btn-outline-luxury" asp-action="Orders" asp-route-status="1">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Đơn chờ xử lý (@Model.PendingOrderCount)
        </a>
        <a class="btn btn-luxury-action btn-outline-luxury" asp-action="Payments" asp-route-state="error">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            Giao dịch lỗi (@Model.FailedPaymentCount)
        </a>
        <a class="btn btn-luxury-action btn-outline-luxury" asp-action="Products" asp-route-stock="low">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>
            Sắp hết hàng (@Model.LowStockCount)
        </a>
    </div>

    <!-- Primary KPI Cards Row -->
    <div class="row g-3">
        <!-- Revenue Card -->
        <div class="col-6 col-md-3">
            <div class="stat-card-luxury" style="--accent-gradient: linear-gradient(180deg, #2e7d32, #66bb6a); --icon-bg: rgba(46, 125, 50, 0.1); --icon-color: #2e7d32;">
                <div class="stat-card-header">
                    <span class="stat-label-luxury">Doanh thu hoàn tất</span>
                    <div class="stat-icon-box">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                </div>
                <div class="stat-value-luxury">@Model.Revenue.ToString("N0")đ</div>
                <div class="stat-hint-luxury">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    Từ đơn hàng hoàn thành
                </div>
            </div>
        </div>

        <!-- Orders Card -->
        <div class="col-6 col-md-3">
            <div class="stat-card-luxury" style="--accent-gradient: linear-gradient(180deg, #1565c0, #42a5f5); --icon-bg: rgba(21, 101, 192, 0.1); --icon-color: #1565c0;">
                <div class="stat-card-header">
                    <span class="stat-label-luxury">Tổng đơn hàng</span>
                    <div class="stat-icon-box">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    </div>
                </div>
                <div class="stat-value-luxury">@Model.OrderCount</div>
                <div class="stat-hint-luxury">
                    Chờ: <span class="fw-bold">@Model.PendingOrderCount</span> | Giao: <span class="fw-bold">@Model.ShippingOrderCount</span>
                </div>
            </div>
        </div>

        <!-- Customers Card -->
        <div class="col-6 col-md-3">
            <div class="stat-card-luxury" style="--accent-gradient: linear-gradient(180deg, #6a1b9a, #ab47bc); --icon-bg: rgba(106, 27, 154, 0.1); --icon-color: #6a1b9a;">
                <div class="stat-card-header">
                    <span class="stat-label-luxury">Khách hàng</span>
                    <div class="stat-icon-box">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                </div>
                <div class="stat-value-luxury">@Model.CustomerCount</div>
                <div class="stat-hint-luxury">Tài khoản đã đăng ký</div>
            </div>
        </div>

        <!-- Products Card -->
        <div class="col-6 col-md-3">
            <div class="stat-card-luxury" style="--accent-gradient: linear-gradient(180deg, #d84315, #ff7043); --icon-bg: rgba(216, 67, 21, 0.1); --icon-color: #d84315;">
                <div class="stat-card-header">
                    <span class="stat-label-luxury">Tổng sản phẩm</span>
                    <div class="stat-icon-box">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><polygon points="12 22.08 12 12 3 6.92 3 17.08 12 22.08"></polygon><polygon points="12 12 21 6.92 21 17.08 12 22.08"></polygon><polygon points="12 2 3 6.92 12 12 21 6.92 12 2"></polygon><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    </div>
                </div>
                <div class="stat-value-luxury">@Model.ProductCount</div>
                <div class="stat-hint-luxury">
                    Sắp hết hàng: <span class="fw-bold text-danger">@Model.LowStockCount</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Status Cards Row -->
    <div class="row g-2">
        <div class="col-6 col-md-3">
            <div class="sec-stat-card">
                <div class="sec-stat-info">
                    <span class="sec-stat-label">Đơn hoàn tất</span>
                    <span class="sec-stat-value">@Model.CompletedOrderCount</span>
                </div>
                <div class="sec-stat-indicator" style="--ind-color: #2e7d32;"></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sec-stat-card">
                <div class="sec-stat-info">
                    <span class="sec-stat-label">Đơn đã hủy</span>
                    <span class="sec-stat-value">@Model.CancelledOrderCount</span>
                </div>
                <div class="sec-stat-indicator" style="--ind-color: #c62828;"></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sec-stat-card">
                <div class="sec-stat-info">
                    <span class="sec-stat-label">Đơn hoàn tiền</span>
                    <span class="sec-stat-value">@Model.RefundedOrderCount</span>
                </div>
                <div class="sec-stat-indicator" style="--ind-color: #283593;"></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sec-stat-card">
                <div class="sec-stat-info">
                    <span class="sec-stat-label">Giao dịch lỗi</span>
                    <span class="sec-stat-value">@Model.FailedPaymentCount</span>
                </div>
                <div class="sec-stat-indicator" style="--ind-color: #ef6c00;"></div>
            </div>
        </div>
    </div>

    <!-- Interactive Charts Row -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="chart-card-luxury">
                <div class="chart-header">
                    <span class="chart-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                        Doanh thu 30 ngày qua
                    </span>
                    <span class="badge badge-soft">Hàng ngày</span>
                </div>
                <div class="chart-container-inner">
                    <canvas id="dailyRevenueChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="chart-card-luxury">
                <div class="chart-header">
                    <span class="chart-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary"><rect x="18" y="3" width="4" height="18" rx="1"></rect><rect x="10" y="8" width="4" height="13" rx="1"></rect><rect x="2" y="13" width="4" height="8" rx="1"></rect></svg>
                        Doanh thu 12 tháng qua
                    </span>
                    <span class="badge badge-soft">Hàng tháng</span>
                </div>
                <div class="chart-container-inner">
                    <canvas id="monthlyRevenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Lists Row (Tables overhauled into beautiful visual blocks) -->
    <div class="row g-3">
        <!-- Top Products -->
        <div class="col-lg-4">
            <div class="list-card-luxury">
                <div class="list-card-header">
                    <h5 class="list-card-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-warning"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                        Sản phẩm bán chạy
                    </h5>
                    <span class="badge bg-secondary-modern text-primary text-xs px-2 py-1">Top 8</span>
                </div>
                <div class="top-products-list">
                    @{ int rank = 1; }
                    @foreach (var p in Model.TopProducts)
                    {
                        <div class="top-product-item">
                            <span class="rank-medal @(rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "rank-other")">@rank</span>
                            <img class="product-avatar-luxury" src="@MyUtil.GetHangHoaImageUrl(p.Hinh, p.MaHh)" alt="@p.TenHh" />
                            <div class="product-info-luxury">
                                <div class="product-name-luxury" title="@p.TenHh">@p.TenHh</div>
                                <div class="product-sale-count">Đã bán: <span class="fw-bold">@p.QuantitySold</span> sản phẩm</div>
                            </div>
                            <div class="product-revenue-luxury">@p.Revenue.ToString("N0")đ</div>
                        </div>
                        rank++;
                    }
                </div>
            </div>
        </div>

        <!-- Inventory Warning -->
        <div class="col-lg-4">
            <div class="list-card-luxury">
                <div class="list-card-header">
                    <h5 class="list-card-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-danger"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        Cảnh báo tồn kho
                    </h5>
                    <span class="badge bg-danger text-white text-xs px-2 py-1">Khẩn cấp</span>
                </div>
                <div class="top-products-list">
                    @foreach (var p in Model.LowStockProducts)
                    {
                        var percentage = p.Stock <= 0 ? 0 : Math.Clamp((p.Stock * 100) / Math.Max(1, p.LowStockThreshold), 0, 100);
                        <div class="top-product-item">
                            <img class="product-avatar-luxury" src="@MyUtil.GetHangHoaImageUrl(p.Hinh, p.MaHh)" alt="@p.TenHh" />
                            <div class="product-info-luxury">
                                <div class="product-name-luxury" title="@p.TenHh">@p.TenHh</div>
                                <div class="product-sale-count d-flex justify-content-between align-items-center">
                                    <span>Tồn: <strong class="@(p.IsOutOfStock ? "text-danger" : "text-warning")">@p.Stock</strong> / Ngưỡng @p.LowStockThreshold</span>
                                    <span class="badge @(p.IsOutOfStock ? "bg-danger" : "bg-warning text-dark") text-xs">@(p.IsOutOfStock ? "Hết hàng" : "Sắp hết")</span>
                                </div>
                                <div class="progress-luxury">
                                    <div class="progress-bar-luxury @(p.IsOutOfStock ? "progress-bar-danger" : "")" style="width: @percentage%"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Newest Orders -->
        <div class="col-lg-4">
            <div class="list-card-luxury">
                <div class="list-card-header">
                    <h5 class="list-card-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        Đơn hàng mới nhất
                    </h5>
                    <span class="badge bg-secondary-modern text-primary text-xs px-2 py-1">Giao dịch mới</span>
                </div>
                <div class="top-products-list">
                    @foreach (var o in Model.NewOrders)
                    {
                        <div class="order-item-luxury">
                            <div class="order-meta">
                                <a class="order-code" asp-action="OrderDetails" asp-route-id="@o.MaHd">#@o.MaHd</a>
                                <span class="order-time">@o.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                <span class="order-customer" title="@o.CustomerName">@o.CustomerName</span>
                            </div>
                            <div class="order-total-block">
                                <span class="order-total">@o.Total.ToString("N0")đ</span>
                                <span class="status-chip @(o.StatusId == 0 ? "status-pending" : o.StatusId == 1 || o.StatusId == 3 ? "status-success" : o.StatusId < 0 ? "status-failed" : "status-info")" style="font-size: 0.65rem; padding: 0.1rem 0.4rem;">@o.StatusName</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CDN For Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Load serialized C# data
            const dailyLabels = @Html.Raw(Json.Serialize(Model.DailyRevenue.Select(x => x.Label)));
            const dailyData = @Html.Raw(Json.Serialize(Model.DailyRevenue.Select(x => x.Value)));

            const monthlyLabels = @Html.Raw(Json.Serialize(Model.MonthlyRevenue.Select(x => x.Label)));
            const monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyRevenue.Select(x => x.Value)));

            // Formatter helper for VNĐ tooltips
            const formatVnd = (value) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);

            // Chart.js Default styling tweaks
            Chart.defaults.font.family = '"Be Vietnam Pro", "Segoe UI", sans-serif';
            Chart.defaults.font.size = 11;
            Chart.defaults.color = '#7e6958';

            // 1. Daily Revenue Chart (Area Line Chart)
            const dailyCtx = document.getElementById('dailyRevenueChart').getContext('2d');
            const dailyGradient = dailyCtx.createLinearGradient(0, 0, 0, 250);
            dailyGradient.addColorStop(0, 'rgba(184, 134, 86, 0.35)'); // Soft luxury gold glow
            dailyGradient.addColorStop(1, 'rgba(255, 252, 248, 0.05)');

            new Chart(dailyCtx, {
                type: 'line',
                data: {
                    labels: dailyLabels,
                    datasets: [{
                        label: 'Doanh thu',
                        data: dailyData,
                        borderColor: '#b88656', // Gold line
                        borderWidth: 2.5,
                        backgroundColor: dailyGradient,
                        fill: true,
                        tension: 0.35, // Smooth curves
                        pointBackgroundColor: '#7b5236',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointRadius: 3,
                        pointHoverRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' ' + context.dataset.label + ': ' + formatVnd(context.raw);
                                }
                            },
                            backgroundColor: '#1f1814',
                            titleColor: '#efe4d3',
                            bodyColor: '#ffffff',
                            padding: 10,
                            borderRadius: 8,
                            borderColor: 'rgba(184, 134, 86, 0.25)',
                            borderWidth: 1
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(120, 84, 53, 0.06)' },
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1e6) return (value / 1e6) + 'M';
                                    if (value >= 1e3) return (value / 1e3) + 'K';
                                    return value;
                                }
                            }
                        }
                    }
                }
            });

            // 2. Monthly Revenue Chart (Bar Chart)
            const monthlyCtx = document.getElementById('monthlyRevenueChart').getContext('2d');
            const monthlyGradient = monthlyCtx.createLinearGradient(0, 0, 0, 250);
            monthlyGradient.addColorStop(0, '#7b5236'); // Chocolate
            monthlyGradient.addColorStop(1, '#b88656'); // Warm gold

            new Chart(monthlyCtx, {
                type: 'bar',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Doanh thu',
                        data: monthlyData,
                        backgroundColor: monthlyGradient,
                        borderRadius: 6, // Rounded bars
                        borderSkipped: false,
                        maxBarThickness: 32
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' ' + context.dataset.label + ': ' + formatVnd(context.raw);
                                }
                            },
                            backgroundColor: '#1f1814',
                            titleColor: '#efe4d3',
                            bodyColor: '#ffffff',
                            padding: 10,
                            borderRadius: 8,
                            borderColor: 'rgba(184, 134, 86, 0.25)',
                            borderWidth: 1
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(120, 84, 53, 0.06)' },
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1e6) return (value / 1e6) + 'M';
                                    if (value >= 1e3) return (value / 1e3) + 'K';
                                    return value;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
