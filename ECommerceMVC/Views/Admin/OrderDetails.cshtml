@model HoaDon
@{ Layout = "_AdminLayout"; ViewData["Title"] = $"Chi tiết đơn #{Model.MaHd}"; var total = Model.ChiTietHds.Sum(x => x.SoLuong * x.DonGia * (1 - x.GiamGia)) + Model.PhiVanChuyen; }
<div class="row g-4"><div class="col-lg-4"><div class="admin-card"><h5>Thông tin đơn</h5><p><b>Khách:</b> @Model.HoTen (@Model.MaKh)</p><p><b>Địa chỉ:</b> @Model.DiaChi</p><p><b>Ngày đặt:</b> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p><p><b>Cần/Giao:</b> @Model.NgayCan?.ToString("dd/MM/yyyy") / @Model.NgayGiao?.ToString("dd/MM/yyyy")</p><p><b>Thanh toán:</b> @Model.CachThanhToan</p><p><b>Vận chuyển:</b> @Model.CachVanChuyen (@Model.PhiVanChuyen.ToString("N0") đ)</p><p><b>Ghi chú:</b> @Model.GhiChu</p><p><b>Tổng:</b> @total.ToString("N0") đ</p><form asp-action="OrderStatus" asp-route-id="@Model.MaHd" method="post" class="mb-2"><label class="form-label">Cập nhật trạng thái</label><select name="statusId" class="form-select mb-2" asp-items="ViewBag.Statuses"></select><label class="form-label">Ghi chú admin</label><input name="adminNote" class="form-control mb-2" maxlength="50" placeholder="Tối đa 50 ký tự" /><button class="btn btn-primary w-100">Lưu trạng thái</button></form><form asp-action="OrderRefund" asp-route-id="@Model.MaHd" method="post" onsubmit="return confirm('Ghi nhận hoàn tiền?')"><button class="btn btn-outline-danger w-100">Hoàn tiền</button></form></div></div><div class="col-lg-8"><div class="admin-card"><h5>Sản phẩm trong đơn</h5><table class="table table-admin"><thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Giảm</th><th>Thành tiền</th></tr></thead><tbody>@foreach (var ct in Model.ChiTietHds) { var line = ct.SoLuong * ct.DonGia * (1 - ct.GiamGia); <tr><td>@ct.MaHhNavigation.TenHh</td><td>@ct.SoLuong</td><td>@ct.DonGia.ToString("N0") đ</td><td>@ct.GiamGia.ToString("P0")</td><td>@line.ToString("N0") đ</td></tr> }</tbody></table></div></div></div>
