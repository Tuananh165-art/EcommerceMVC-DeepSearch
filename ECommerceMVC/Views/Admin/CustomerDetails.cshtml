@model KhachHang
@{ Layout = "_AdminLayout"; ViewData["Title"] = $"Khách hàng {Model.MaKh}"; var total = Model.HoaDons.Where(x => ECommerceMVC.Helpers.OrderStatusHelper.IsCompleted(x.MaTrangThai)).SelectMany(x => x.ChiTietHds).Sum(x => x.SoLuong * x.DonGia * (1 - x.GiamGia)); }
<div class="row g-4"><div class="col-lg-4"><div class="admin-card"><h5>@Model.HoTen</h5><p>@Model.Email<br/>@Model.DienThoai<br/>@Model.DiaChi</p><p>Trạng thái: <span class="badge @(Model.HieuLuc ? "bg-success" : "bg-danger")">@(Model.HieuLuc ? "Hoạt động" : "Đã khóa")</span></p><p>Tổng mua: <b>@total.ToString("N0") đ</b></p><form asp-action="CustomerRole" asp-route-id="@Model.MaKh" method="post"><label class="form-label">Phân nhóm/quyền</label><select name="role" class="form-select mb-2"><option value="0" selected="@(Model.VaiTro != MySetting.ADMIN_ROLE)">Khách hàng</option><option value="1" selected="@(Model.VaiTro == MySetting.ADMIN_ROLE)">Admin</option></select><button class="btn btn-primary w-100">Cập nhật</button></form></div></div><div class="col-lg-8"><div class="admin-card"><h5>Lịch sử mua hàng</h5><table class="table table-admin"><thead><tr><th>Mã</th><th>Ngày</th><th>Trạng thái</th><th>Tổng</th><th></th></tr></thead><tbody>@foreach (var o in Model.HoaDons.OrderByDescending(x => x.NgayDat)) { var orderTotal = o.ChiTietHds.Sum(x => x.SoLuong * x.DonGia * (1 - x.GiamGia)) + o.PhiVanChuyen; <tr><td>#@o.MaHd</td><td>@o.NgayDat.ToString("dd/MM/yyyy")</td><td>@o.MaTrangThaiNavigation.TenTrangThai</td><td>@orderTotal.ToString("N0") đ</td><td><a asp-action="OrderDetails" asp-route-id="@o.MaHd">Xem</a></td></tr> }</tbody></table></div></div></div>
