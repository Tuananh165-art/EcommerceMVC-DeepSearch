# =====================================================
# Database
# =====================================================
# If using the bundled SQL Server container:
DB_CONNECTION_STRING=Server=sqlserver,1433;Database=Hshop2023;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;Encrypt=False;

# If using an existing SQL Server on the host:
# DB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=Hshop2023;User Id=sa;Password=YourExistingPassword;TrustServerCertificate=True;Encrypt=False;

# SQL Server container password (only needed if using bundled sqlserver service)
SA_PASSWORD=YourStrong@Passw0rd

# =====================================================
# SMTP / Email
# =====================================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=HShop

# =====================================================
# VNPay Payment
# =====================================================
VNPAY_TMNCODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/payment/vnpay-callback
VNPAY_IPN_URL=http://localhost:8080/payment/vnpay-ipn

# =====================================================
# MoMo Payment
# =====================================================
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=http://localhost:8080/payment/momo-callback

# =====================================================
# Admin
# =====================================================
ADMIN_SECRET_CODE=

# =====================================================
# ASP.NET Core
# =====================================================
ASPNETCORE_ENVIRONMENT=Production
